# Copy to .env (CLI) or paste into Portainer's "Environment variables" (Advanced mode).
# Generate secrets with:  openssl rand -hex 16
# Keep comments on their own lines (Portainer does not strip trailing comments).

STACK_VERSION=9.5.5

# Superuser - you log in to Kibana as "elastic" with this
ELASTIC_PASSWORD=change-me-superuser
# Internal: Kibana -> Elasticsearch
KIBANA_SYSTEM_PASSWORD=change-me-kibana
# Low-privilege write-only account used by every agent and the Unity console
SHIPPER_PASSWORD=change-me-shipper
# Must be 32+ characters
KIBANA_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef

# http://<this VM's LAN IP>:5601 (used for links Kibana generates)
KIBANA_PUBLIC_URL=http://192.168.1.60:5601

# About half the VM's RAM, never above 31g
ES_HEAP=4g
# Unity logs + Filebeat logs
LOG_RETENTION=30d
# Metricbeat
METRICS_RETENTION=14d
# Optional: "dev" / "qa" etc. to keep environments apart (logs-unity.console-<namespace>)
UNITY_NAMESPACE=default

# Where the console image is built from. Must contain elastic.js + elk-setup.js.
CONSOLE_BUILD_CONTEXT=https://github.com/kroecks/unity-remote-console.git#master:server
